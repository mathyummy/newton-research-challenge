rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId));
    }

    function isTeacher(sessionId) {
      return signedIn() && sessionDoc(sessionId).data.teacherUid == request.auth.uid;
    }

    match /sessions/{sessionId} {
      // All three screens need only the current session state.
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isTeacher(sessionId)
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedCount', 'updatedAt'])
          && request.resource.data.completedCount == resource.data.completedCount + 1)
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamCount', 'updatedAt'])
          && request.resource.data.teamCount == resource.data.teamCount + 1);
      allow delete: if isTeacher(sessionId);

      match /teams/{teamId} {
        // Students can only see their own team. Teacher device can see the roster.
        allow read: if signedIn()
          && (resource.data.ownerUid == request.auth.uid || isTeacher(sessionId));
        allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
        // MVP rule: owner can add a new answer, but cannot delete the team.
        allow update: if (isTeacher(sessionId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'scoring', 'updatedAt']))
          || (signedIn()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'submitted', 'updatedAt']));
        allow delete: if isTeacher(sessionId);
      }

      match /leaderboard/{teamId} {
        allow read: if isTeacher(sessionId)
          || (signedIn() && sessionDoc(sessionId).data.leaderboardVisible == true);
        allow create: if isTeacher(sessionId)
          && request.resource.data.keys().hasOnly(['teamName', 'score', 'updatedAt']);
        allow update: if isTeacher(sessionId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamName', 'score', 'updatedAt']);
        allow delete: if isTeacher(sessionId);
      }

      match /publicAnswers/{answerId} {
        // The screen can read only the public projection: team name + answer.
        // Member names and seat numbers stay in the private teams collection.
        allow read: if isTeacher(sessionId)
          || (signedIn() && sessionDoc(sessionId).data.published == true);
        allow create: if signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/sessions/$(sessionId)/teams/$(request.resource.data.teamId)).data.ownerUid == request.auth.uid;
        allow update: if false;
        allow delete: if isTeacher(sessionId);
      }
    }
  }
}
